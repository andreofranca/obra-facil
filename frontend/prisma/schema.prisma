generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                @id @default(uuid())
  name         String
  email        String                @unique
  phone        String?
  password     String
  role         UserRole
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  cliente      Cliente?
  profissional Profissional?
  mensagens       MensagemSolicitacao[]
  historicoStatus HistoricoStatusServico[]

  @@map("users")
}

model Cliente {
  id           String             @id @default(uuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id])
  solicitacoes    SolicitarServico[]
  avaliacoesServico AvaliacaoServico[]

  @@map("clients")
}

model Profissional {
  id           String             @id @default(uuid())
  userId       String             @unique
  descricao    String?
  experiencia  Int?
  ativo        Boolean            @default(true)
  user         User               @relation(fields: [userId], references: [id])
  avaliacoesServico AvaliacaoServico[]
  servicos        Servico[]
  solicitacoes SolicitarServico[]
  propostas    Proposta[]
  endereco     Endereco?
  planos       ProfissionalPlano[]
  transfers    Transfer[]

  @@map("professionals")
}

model CategoriaServico {
  id       String    @id @default(uuid())
  nome     String    @unique
  servicos Servico[]

  @@map("service_categories")
}

model Servico {
  id             String           @id @default(uuid())
  titulo         String
  descricao      String?
  categoriaId    String
  profissionalId String
  categoria      CategoriaServico @relation(fields: [categoriaId], references: [id])
  profissional   Profissional     @relation(fields: [profissionalId], references: [id])

  @@index([categoriaId])
  @@index([profissionalId])
  @@map("services")
}

model SolicitarServico {
  id             String                @id @default(uuid())
  titulo         String
  descricao      String
  status         SolicitacaoStatus     @default(ABERTA)
  clienteId      String
  profissionalId String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime
  mensagens      MensagemSolicitacao[]
  propostas      Proposta[]
  avaliacao      AvaliacaoServico?
  historicoStatus HistoricoStatusServico[]
  cliente        Cliente               @relation(fields: [clienteId], references: [id])
  profissional   Profissional?         @relation(fields: [profissionalId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([profissionalId])
  @@index([status])
  @@map("service_requests")
}

model MensagemSolicitacao {
  id            String           @id @default(uuid())
  solicitacaoId String
  usuarioId     String?
  mensagem      String
  createdAt     DateTime         @default(now())
  solicitacao   SolicitarServico @relation(fields: [solicitacaoId], references: [id])
  autor         User?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([solicitacaoId])
  @@index([usuarioId])
  @@map("service_request_messages")
}

model Proposta {
  id             String           @id @default(cuid())
  valor          Decimal
  prazoDias      Int
  mensagem       String
  status         PropostaStatus   @default(PENDENTE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  solicitacaoId  String
  profissionalId String
  solicitacao    SolicitarServico @relation(fields: [solicitacaoId], references: [id])
  profissional   Profissional     @relation(fields: [profissionalId], references: [id])

  @@index([solicitacaoId])
  @@index([profissionalId])
  @@map("proposals")
}

model AvaliacaoServico {
  id             String           @id @default(uuid())
  solicitacaoId  String           @unique
  clienteId      String
  profissionalId String
  nota           Int
  comentario     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  solicitacao    SolicitarServico @relation(fields: [solicitacaoId], references: [id])
  cliente        Cliente          @relation(fields: [clienteId], references: [id])
  profissional   Profissional     @relation(fields: [profissionalId], references: [id])

  @@index([profissionalId])
  @@index([clienteId])
  @@map("service_ratings")
}

model HistoricoStatusServico {
  id            String             @id @default(uuid())
  solicitacaoId String
  usuarioId     String
  statusAnterior SolicitacaoStatus?
  novoStatus    SolicitacaoStatus
  createdAt     DateTime           @default(now())
  solicitacao   SolicitarServico   @relation(fields: [solicitacaoId], references: [id])
  usuario       User               @relation(fields: [usuarioId], references: [id])

  @@index([solicitacaoId])
  @@index([usuarioId])
  @@map("service_request_status_history")
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum SolicitacaoStatus {
  ABERTA
  PROPOSTAS
  NEGOCIACAO
  ACEITA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
  EXPIRADA
  RECUSADA
}

enum PropostaStatus {
  PENDENTE
  ACEITA
  RECUSADA
  CANCELADA
  EXPIRADA
}

model Endereco {
  id             String       @id @default(uuid())
  profissionalId String       @unique
  cidade         String?
  estado         String?
  cep            String?
  bairro         String?
  logradouro     String?
  numero         String?
  complemento    String?
  lat            Float?
  lng            Float?
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  @@index([cidade])
  @@map("addresses")
}

enum ProfissionalPlanoStatus {
  ATIVO
  INATIVO
  CANCELADO
  EXPIRADO
}

model Plano {
  id                  String              @id @default(uuid())
  nome                String
  tipo                String
  descricao           String?
  valor               Decimal
  ativo               Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  profissionaisPlanos ProfissionalPlano[]

  @@map("plans")
}

model ProfissionalPlano {
  id             String                  @id @default(uuid())
  profissionalId String
  planoId        String
  dataInicio     DateTime
  dataFim        DateTime?
  status         ProfissionalPlanoStatus @default(ATIVO)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  profissional   Profissional            @relation(fields: [profissionalId], references: [id])
  plano          Plano                   @relation(fields: [planoId], references: [id])

  @@index([profissionalId])
  @@index([planoId])
  @@index([status])
  @@index([dataFim])
  @@map("professional_plans")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id            String         @id @default(uuid())
  amount        Decimal
  currency      String         @default("BRL")
  status        PaymentStatus  @default(PENDING)
  providerId    String?        
  referenceId   String?        
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transfers     Transfer[]

  @@index([referenceId])
  @@index([providerId])
  @@index([status])
  @@map("transactions")
}

model Transfer {
  id            String         @id @default(uuid())
  transactionId String
  recipientId   String
  amount        Decimal
  status        TransferStatus @default(PENDING)
  providerId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  transaction   Transaction    @relation(fields: [transactionId], references: [id])
  profissional  Profissional   @relation(fields: [recipientId], references: [id])

  @@index([transactionId])
  @@index([recipientId])
  @@map("transfers")
}
